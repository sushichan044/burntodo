{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burntodo-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-04",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remix-hono-turbo-example",
      "database_id": "2b19135e-ebbd-4723-8bcf-74be224781d9"
    }
  ],
  "env": {
    "dev": {
      "vars": {
        "PASSWORD_SALT": "$2a$10$ACtdEZ3JjyfBPL1t6Kgmtu"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "remix-hono-turbo-example",
          "database_id": "2b19135e-ebbd-4723-8bcf-74be224781d9"
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
