{
  "name": "backend",
  "scripts": {
    "dev": "wrangler dev src/index.ts --env dev",
    "deploy": "wrangler deploy --minify src/index.ts",
    "db:migrate": "drizzle-kit generate:sqlite",
    "db:migrate-custom": "drizzle-kit generate:sqlite --custom",
    "db:push": "wrangler d1 migrations apply remix-hono-turbo-example --local",
    "db:push-remote": "wrangler d1 migrations apply remix-hono-turbo-example --remote"
  },
  "dependencies": {
    "@repo/api": "workspace:^",
    "hono": "4.8.3"
  },
  "devDependencies": {
    "@virtual-live-lab/eslint-config": "catalog:eslint",
    "@virtual-live-lab/prettier-config": "catalog:prettier",
    "@virtual-live-lab/tsconfig": "catalog:typescript",
    "drizzle-kit": "0.31.4",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript",
    "wrangler": "catalog:cloudflare"
  }
}
