{
  "extends": [
    "@virtual-live-lab/tsconfig/react",
    "@virtual-live-lab/tsconfig/vite"
  ],
  "compilerOptions": {
    "types": ["vite/client"],
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    ".react-router/types/**/*",
    "**/*.ts",
    "**/*.tsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx",
    "worker-configuration.d.ts"
  ]
}
