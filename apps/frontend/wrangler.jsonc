{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burntodo-frontend",
  "main": "workers/app.ts",
  "compatibility_date": "2025-07-04",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "BACKEND",
      "service": "burntodo-backend",
    },
  ],
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
  },
}
